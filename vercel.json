{
  "functions": {
    "api/*.py": {
      "runtime": "vercel-python@3.9"
    }
  },
  "routes": [
    { "src": "/pack",       "dest": "/api/pack.py" },
    { "src": "/pack/tsv",   "dest": "/api/pack.py" },
